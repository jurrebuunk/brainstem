{
  "name": "@jurrebuunk/brainstem",
  "version": "0.1.0-alpha.0",
  "description": "A lightweight decision and orchestration layer for autonomous AI agents.",
  "main": "src/core/brainstem.mjs",
  "exports": {
    ".": "./src/core/brainstem.mjs",
    "./runtime": "./src/runtime/runtime.mjs",
    "./sdk": "./src/sdk/index.mjs",
    "./record-stores": "./src/core/record-stores.mjs",
    "./checkpoints": "./src/runtime/checkpoints.mjs"
  },
  "scripts": {
    "start": "node brainstem.mjs",
    "start:once": "node brainstem.mjs --once",
    "start:once:all": "node brainstem.mjs --once --all",
    "plugin:test": "node run-plugin-test.mjs",
    "check": "node --check brainstem.mjs && find src plugins -name '*.mjs' -exec node --check {} \\;",
    "test": "node --test tests/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "monitoring",
    "laya",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@receptron/laya": "^0.1.1"
  },
  "bin": {
    "brainstem": "brainstem.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurrebuunk/brainstem.git"
  },
  "bugs": {
    "url": "https://github.com/jurrebuunk/brainstem/issues"
  },
  "homepage": "https://github.com/jurrebuunk/brainstem#readme",
  "files": [
    "brainstem.mjs",
    "brainstem.config.example.mjs",
    ".env.example",
    "src/",
    "plugins/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
