# Copy this file to .env.
# brainstem.mjs loads .env automatically.

# Optional GitHub token for private repositories or higher rate limits.
GITHUB_TOKEN=github_pat_or_token_here

# Optional Matrix access token for plugins/matrix.
MATRIX_ACCESS_TOKEN=matrix_access_token_here

# Optional IMAP password for plugins/email-imap.
EMAIL_PASSWORD=email_password_here

# Database for all Brainstem state (records, checkpoints, telemetry, auth).
# Default: SQLite file in data/. See docs/state.md.
# BRAINSTEM_DATABASE_URL=sqlite:data/brainstem.sqlite
# BRAINSTEM_DATABASE_URL=postgres://brainstem:change_me@postgres:5432/brainstem

# Cluster mode (docs/cluster.md). Defaults suit a single process.
# BRAINSTEM_ROLE=all
# BRAINSTEM_QUEUES=poll,decide,deliver
# BRAINSTEM_CONFIG_SOURCE=file
# BRAINSTEM_HEALTH_PORT=8081
# BRAINSTEM_LAYA_WORKERS=0
# BRAINSTEM_LAYA_MODEL_DIR=/models
# Core/api processes: wait this long for migrations instead of exiting.
# BRAINSTEM_SCHEMA_WAIT_MS=0
# Where cores without a config file send telemetry (the API).
# BRAINSTEM_TELEMETRY_URL=http://api:5174/api/events
# BRAINSTEM_TELEMETRY_TOKEN=
# Machine token the API requires on POST /api/events (cores send it).
# BRAINSTEM_API_TOKEN=

# Observability (docs/observability.md).
# GET /metrics is on by default; optional bearer token.
# BRAINSTEM_METRICS=true
# BRAINSTEM_METRICS_TOKEN=
# OpenTelemetry traces over OTLP/HTTP; off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_SERVICE_NAME=brainstem-core

# Password for the optional postgres service in docker-compose.example.yml.
# POSTGRES_PASSWORD=change_me

# agentos-runner prompt tasks (OpenAI-compatible endpoint)
AGENTOS_MODEL_API_KEY=
